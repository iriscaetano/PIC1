clear; clc;
%% =========================================================
% 1. CONFIGURAÇÃO (Escolhe o modelo e as equações)
%% =========================================================
ficheiro_resultados = 'RESULTADOS_TODOS_ESTATICO_ISB.xlsx';

% --- ESCOLHA DO MODELO (Descomenta apenas um bloco) ---

% MODELO: ANTONIO
modelo_para_analise = 'Antonio'; 
nome_coluna_erro = 'Erro_Antonio_mm'; % Coluna exata que está no teu Excel
eq_X = "GHx = 25.5316 + 0.6334*ACx + 0.7842*ACy - 0.0832*AIz - 0.2673*L_AA_TS + 0.0365*L_AA_AI - 0.5353*L_AA_AC + 0.0843*L_TS_AI + 0.2350*L_TS_AC - 0.1246*L_AI_AC - 0.0237*Age + 2.1296*Sex - 1.1900*Height + 0.0221*Weight";
eq_Y = "GHy = -6.7070 - 0.2514*ACx + 0.7558*ACy + 0.0264*AIz - 0.0620*L_AA_AI - 1.7641*Sex - 5.7094*Height";
eq_Z = "GHz = -22.5233 + 0.5954*ACx + 0.0600*ACy + 0.1085*AIz + 0.3983*ACz - 0.3880*L_AA_AC - 0.0197*L_TS_AI - 0.0934*L_TS_AC + 0.0558*Age + 0.2930*Sex + 26.4715*Height - 0.0361*Weight";

% MODELO: MESKERS
%modelo_para_analise = 'Meskers';
%nome_coluna_erro = 'Erro_Meskers_mm'; % Coluna exata que está no teu Excel
%eq_X = "GHx = 18.9743 + 0.2434*PrC_x + 0.2341*AI_x + 0.0558*PrC_y + 0.1590*Dist_AI_AA";
%eq_Y = "GHy = -3.8791 - 0.3940*Dist_AA_AC + 0.1732*PrC_y + 0.1205*AI_x - 0.1002*Dist_PrC_AC";
%eq_Z = "GHz = 9.2629 + 1.0255*PrC_z - 0.2403*PrC_y + 0.1720*Dist_TS_PrC";

%% =========================================================
% 2. IDENTIFICAÇÃO ÚNICA DE VARIÁVEIS
%% =========================================================
T_mestre = readtable(ficheiro_resultados);
T_land = readtable('BNMS_LANDMARKS.xlsx', 'VariableNamingRule', 'preserve');

% Extrair variáveis das equações para saber o que calcular
todas_eqs = strcat(eq_X, " ", eq_Y, " ", eq_Z);
tokens = regexp(todas_eqs, '(?<!\d)[A-Za-z_][A-Za-z0-9_]*', 'match');
vars_unicas = sort(setdiff(unique(tokens), {'GHx','GHy','GHz'}));

X_matriz = []; y_final = [];
Nomes_Sucesso = {};

%% =========================================================
% 3. LOOP DE RECOLHA DE DADOS
%% =========================================================
fprintf('Análise de Sensibilidade: Erro Global do Excel (%s) ao Quadrado...\n', modelo_para_analise);
pasta_database = uigetdir(pwd, 'Seleciona a pasta Kinematic_output_database');

for i = 1:height(T_mestre)
    nome_paciente = T_mestre.Paciente{i};
    f_out = dir(fullfile(pasta_database, '**', sprintf('%s_static_t*_output.xlsx', nome_paciente)));
    f_out = f_out(~startsWith({f_out.name}, '~$'));
    
    if ~isempty(f_out)
        try
            path_v = fullfile(f_out(1).folder, f_out(1).name);
            data_demo = readcell(path_v, 'Sheet', 'Sheet1');
            getV = @(lab) data_demo{find(strcmpi(data_demo(:,1), lab), 1), 2};
            
            % --- Biblioteca de Cálculos ---
            calc.Age = double(getV('Age'));
            calc.Height = double(getV('Height'))/100;
            calc.Weight = double(getV('Weight'));
            calc.Sex = 0; if strcmpi(getV('Sex'), 'M'), calc.Sex = 1; end
            
            raw_v = readtable(path_v, 'Sheet', 'vicon', 'VariableNamingRule', 'preserve');
            h_v = raw_v.Properties.VariableNames;
            f_i = @(str) find(contains(h_v, str, 'IgnoreCase', true), 1);
            AA = mean(table2array(raw_v(:, f_i('posterolateral acromion'):f_i('posterolateral acromion')+2)), 1, 'omitnan');
            TS = mean(table2array(raw_v(:, f_i('trigonum'):f_i('trigonum')+2)), 1, 'omitnan');
            AI = mean(table2array(raw_v(:, f_i('inferior angle'):f_i('inferior angle')+2)), 1, 'omitnan');
            AC = mean(table2array(raw_v(:, f_i('Right AC'):f_i('Right AC')+2)), 1, 'omitnan');
            
            z_isb = (AA - TS) / norm(AA - TS); x_isb = cross(z_isb, AI - AA); x_isb = x_isb / norm(x_isb); y_isb = cross(z_isb, x_isb); y_isb = y_isb / norm(y_isb);
            R_isb = [x_isb(:), y_isb(:), z_isb(:)];
            AC_loc = (R_isb' * (AC - AA)')'; AI_loc = (R_isb' * (AI - AA)')';
            calc.ACx = AC_loc(1); calc.ACy = AC_loc(2); calc.ACz = AC_loc(3); calc.AIz = AI_loc(3);
            calc.L_AA_TS = norm(AA-TS); calc.L_AA_AI = norm(AA-AI); calc.L_AA_AC = norm(AA-AC);
            calc.L_TS_AI = norm(TS-AI); calc.L_TS_AC = norm(TS-AC); calc.L_AI_AC = norm(AI-AC);

            idx_stl = find(contains(T_land{:,1}, nome_paciente));
            PrC_stl = [T_land{idx_stl, 11}, T_land{idx_stl, 12}, T_land{idx_stl, 13}];
            x_m = -(TS - AC) / norm(TS - AC); v_temp = AI - AC; z_m = -cross(x_m, v_temp); z_m = z_m / norm(z_m); y_m = -cross(x_m, z_m); y_m = y_m / norm(y_m);
            R_m = [x_m(:), y_m(:), z_m(:)];
            PrC_loc_m = (R_m' * (PrC_stl - AC)')'; AI_loc_m = (R_m' * (AI - AC)')';
            calc.PrC_x = PrC_loc_m(1); calc.PrC_y = PrC_loc_m(2); calc.PrC_z = PrC_loc_m(3);
            calc.AI_x = AI_loc_m(1);
            calc.Dist_AI_AA = norm(AI-AA); calc.Dist_AA_AC = norm(AA-AC);
            calc.Dist_PrC_AC = norm(PrC_stl-AC); calc.Dist_TS_PrC = norm(TS-PrC_stl);

            % Matriz X
            linha = zeros(1, length(vars_unicas));
            for v = 1:length(vars_unicas)
                linha(v) = calc.(vars_unicas{v});
            end
            X_matriz(end+1, :) = linha;
            
            % --- Resposta Y: Erro Global do Excel ao Quadrado ---
            y_final(end+1, 1) = (T_mestre.(nome_coluna_erro)(i))^2;
            Nomes_Sucesso{end+1, 1} = nome_paciente;
            
        catch ME
            fprintf('Pular %s: %s\n', nome_paciente, ME.message);
        end
    end
end

%% =========================================================
% 4. REGRESSÃO E RESULTADOS
%% =========================================================
X_norm = (X_matriz - mean(X_matriz)) ./ std(X_matriz);
y_norm = (y_final - mean(y_final)) / std(y_final);

mdl = fitlm(X_norm, y_norm);
betas = mdl.Coefficients.Estimate(2:end);

% Gráfico
figure('Color','w');
bar(betas, 'FaceColor', [0.1 0.4 0.3]);
set(gca, 'XTick', 1:length(vars_unicas), 'XTickLabel', vars_unicas);
xtickangle(45); grid on;
ylabel('Importância (Beta)');
title(['Impacto no Erro Global^2 (', modelo_para_analise, ')']);
text(1:length(betas), betas, num2str(betas, '%.2f'), 'VerticalAlignment', 'bottom', 'HorizontalAlignment', 'center');

% Tabela
fprintf('\n--- RESULTADOS FINAIS (%s) ---\n', modelo_para_analise);
disp(table(vars_unicas', betas, 'VariableNames', {'Variavel', 'Beta_Impacto'}));

%{

%% =========================================================
% 5. GRÁFICOS DE DISPERSÃO (CROSS-CORRELATION)
%% =========================================================
num_vars = length(vars_unicas);
cols = ceil(sqrt(num_vars)); 
rows = ceil(num_vars / cols);

figure('Color','w','Units','normalized','Position',[0.1 0.1 0.8 0.8], ...
    'Name', ['Cross-Correlation: ', modelo_para_analise]);

for v = 1:num_vars
    subplot(rows, cols, v);
    
    % Dados originais para o eixo X, erro quadrático para o eixo Y
    x_data = X_matriz(:,v);
    y_data = y_final;
    
    % Gráfico de Dispersão
    scatter(x_data, y_data, 30, 'filled', 'MarkerFaceColor', [0.1 0.4 0.3], 'MarkerFaceAlpha', 0.5);
    hold on;
    
    % Linha de Tendência Linear
    p = polyfit(x_data, y_data, 1);
    plot(x_data, polyval(p, x_data), 'r-', 'LineWidth', 1.5);
    
    % Cálculo da Correlação de Pearson (R)
    R = corr(x_data, y_data, 'Rows', 'complete');
    
    % Formatação do Subplot
    title(vars_unicas{v}, 'Interpreter', 'none');
    grid on;
    if mod(v-1, cols) == 0, ylabel('Erro Global^2'); end
    
    % Mostrar o valor de R no canto do gráfico
    text(0.05, 0.90, sprintf('R = %.2f', R), 'Units', 'normalized', 'Color', 'r', 'FontWeight', 'bold');
end

fprintf('Gráficos de Cross-Correlation gerados com sucesso.\n'); 

%%=========================================================
% 6. EXPORTAR MATRIZ DE DADOS PARA EXCEL
%% =========================================================
 if size(X_matriz, 1) == length(Nomes_Sucesso)
    % Criar a tabela base com Nomes e Erro
    T_Export = table(Nomes_Sucesso, y_final, 'VariableNames', {'Paciente', 'Erro_Global_Quadrado'});
    
    % Criar tabela com as variáveis
    T_Vars = array2table(X_matriz, 'VariableNames', vars_unicas);
    
    % Juntar tudo
    T_Final_Export = [T_Export, T_Vars];
    
    % Escrever ficheiro
    nome_ficheiro_xls = sprintf('Matriz_Dados_Sensibilidade_%s.xlsx', modelo_para_analise);
    writetable(T_Final_Export, nome_ficheiro_xls);
    
    fprintf('\n--- FICHEIRO EXPORTADO ---\n');
    fprintf('Dados guardados em: %s\n', nome_ficheiro_xls);
else
    warning('Erro na exportação: O número de nomes não coincide com o número de dados.');
 end
%}

%% =========================================================
% 7. ANÁLISE DE SENSIBILIDADE (Impacto de +20%)
%% =========================================================
% 1. Filtrar a variável 'Sex'
vars_analise = vars_unicas(~strcmpi(vars_unicas, 'Sex'));

% 2. Obter betas e erro base real
betas_modelo = mdl.Coefficients.Estimate(2:end); 
erro_medio_quadratico = mean(y_final); % Valor real do Excel para base da %

impacto_absoluto_mm2 = [];
impacto_percentual = [];

for v = 1:length(vars_analise)
    nome_var = vars_analise{v};
    idx_orig = find(strcmpi(vars_unicas, nome_var));
    
    % Cálculo do impacto absoluto (mm2)
    valor_medio = mean(X_matriz(:, idx_orig));
    vinte_porcento = valor_medio * 0.20;
    num_desvios_padrao = vinte_porcento / std(X_matriz(:, idx_orig));
    
    impacto_bruto = betas_modelo(idx_orig) * num_desvios_padrao;
    
    % Guardar ambos os valores
    impacto_absoluto_mm2(v, 1) = impacto_bruto;
    impacto_percentual(v, 1) = (impacto_bruto / erro_medio_quadratico) * 100;
end

% 3. Criar Tabela com as duas colunas
Tabela_Sensibilidade = table(vars_analise', impacto_absoluto_mm2, impacto_percentual, ...
    'VariableNames', {'Variavel', 'Impacto_no_Erro_Global_mm2', 'Variacao_Erro_Global_Percentual'});

% Ordenar pelo impacto absoluto
[~, idx_sort] = sort(abs(Tabela_Sensibilidade.Impacto_no_Erro_Global_mm2), 'descend');
Tabela_Sensibilidade = Tabela_Sensibilidade(idx_sort, :);

%% =========================================================
% 8. OUTPUT E EXPORTAÇÃO
%% =========================================================
fprintf('\n--- ANÁLISE DE SENSIBILIDADE (Impacto Absoluto vs Percentual) ---\n');
disp(Tabela_Sensibilidade);

% Gráfico baseado na percentagem
figure('Color','w');
bar(Tabela_Sensibilidade.Variacao_Erro_Global_Percentual, 'FaceColor', [0.1 0.5 0.4]);
set(gca, 'XTick', 1:height(Tabela_Sensibilidade), 'XTickLabel', Tabela_Sensibilidade.Variavel);
xtickangle(45); grid on;
ylabel('Impacto no Erro Global (%)');
title('O que acontece ao erro (%) quando a variável sobe 20%?');

% Exportar
writetable(Tabela_Sensibilidade, 'Tabela_Sensibilidade_Final_Antonio.xlsx');
fprintf('Dados exportados para: Tabela_Sensibilidade_Final_Antonio.xlsx\n');
